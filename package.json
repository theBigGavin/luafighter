{
  "name": "luafighter",
  "version": "1.0.0",
  "description": "数据驱动街霸/拳皇自动对战系统 - MAME + Lua + Node.js + React",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:market": "npm run dev -w packages/market-data",
    "dev:manager": "npm run dev -w packages/match-manager",
    "dev:frontend": "npm run dev -w packages/frontend",
    "dev:media": "npm run dev -w packages/media-streamer",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
