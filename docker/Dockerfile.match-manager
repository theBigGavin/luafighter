# LuaFighter 对局管理器 - 基于 MAME 基础镜像
# 这是唯一需要 MAME 可执行文件的服务

FROM lscr.io/linuxserver/mame:latest

# 覆盖 LSIO 的 s6 init，直接跑我们的服务
ENTRYPOINT []

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/usr/games:${PATH}"

# 安装系统依赖（MAME 运行库已自带，只补 Node.js 和推流工具）
RUN apt-get update && apt-get install -y \
    curl \
    xvfb \
    ffmpeg \
    pulseaudio \
    pulseaudio-utils \
    ca-certificates \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# 安装 Node.js 24 LTS
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# 确保 mame 在 PATH 中
RUN ln -sf /usr/games/mame /usr/local/bin/mame

# 创建工作目录
WORKDIR /app

# 创建简化的根配置（只包含需要的 workspaces）
RUN echo '{"name":"luafighter","workspaces":["packages/shared-types","packages/match-manager"],"private":true}' > package.json
COPY tsconfig.json ./

# 复制源码
COPY packages/shared-types ./packages/shared-types
COPY packages/match-manager ./packages/match-manager
COPY scripts/docker-entry-match-manager.sh ./scripts/docker-entry-match-manager.sh

# 安装依赖并构建
RUN npm install --no-audit --no-fund --ignore-scripts && \
    npm run build --workspaces

# 创建 ROM 目录（挂载外部卷）
RUN mkdir -p /app/roms

EXPOSE 9003 9004

CMD ["bash", "/app/scripts/docker-entry-match-manager.sh"]
