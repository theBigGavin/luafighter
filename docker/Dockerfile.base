# LuaFighter 基础镜像
# 包含 Node.js、MAME、FFmpeg、Xvfb

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_VERSION=18.18.0

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    xvfb \
    ffmpeg \
    libsdl2-2.0-0 \
    libfreetype6 \
    libflac8 \
    libjpeg8 \
    libpng16-16 \
    libsqlite3-0 \
    libvorbisfile3 \
    libxinerama1 \
    libxkbcommon0 \
    mesa-utils \
    && rm -rf /var/lib/apt/lists/*

# 安装 Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# 安装 MAME（从官方 PPA 或源码构建）
RUN apt-get update && apt-get install -y \
    mame \
    && rm -rf /var/lib/apt/lists/*

# 创建工作目录
WORKDIR /app

# 复制项目文件
COPY package.json tsconfig.json ./
COPY packages/shared-types ./packages/shared-types
COPY packages/market-data ./packages/market-data
COPY packages/match-manager ./packages/match-manager
COPY packages/media-streamer ./packages/media-streamer
COPY lua-scripts ./lua-scripts

# 安装依赖并构建
RUN npm install \
    && npm run build

# 创建 ROM 目录（挂载外部卷）
RUN mkdir -p /app/roms

EXPOSE 9001 9002 9003 9004 9005

CMD ["node", "packages/match-manager/dist/index.js"]
