# LuaFighter 基础镜像
# 基于预装 MAME 的容器（linuxserver/mame，版本接近 0.288）
# 再安装 Node.js、FFmpeg、Xvfb

FROM lscr.io/linuxserver/mame:latest

# 覆盖 LSIO 的 s6 init，直接跑我们的服务
ENTRYPOINT []

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/usr/games:${PATH}"

# 安装系统依赖（linuxserver/mame 镜像已自带 MAME 运行库，这里只补 Node/推流/虚拟显示）
RUN apt-get update && apt-get install -y \
    curl \
    xvfb \
    ffmpeg \
    pulseaudio \
    pulseaudio-utils \
    ca-certificates \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# 安装 Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# 确保 mame 在 PATH 中
RUN ln -sf /usr/games/mame /usr/local/bin/mame

# 创建工作目录
WORKDIR /app

# 复制项目文件
COPY package.json tsconfig.json ./
COPY packages/shared-types ./packages/shared-types
COPY packages/market-data ./packages/market-data
COPY packages/match-manager ./packages/match-manager
COPY packages/media-streamer ./packages/media-streamer
COPY lua-scripts ./lua-scripts

# 安装依赖并构建
RUN npm install \
    && npm run build

# 创建 ROM 目录（挂载外部卷）
RUN mkdir -p /app/roms

EXPOSE 9001 9002 9003 9004 9005

CMD ["node", "packages/match-manager/dist/index.js"]
